@model DebtManagement.Web.DTOs.CalculatorViewModel

<h1>Financial Overview</h1>

<div class="row">
    <!-- Income vs Debt Difference Section -->
    <div class="difference-section">
        @{
            var difference = Model.TotalIncomes - Model.TotalDebts;
            var ratio = Model.TotalIncomes / (Model.TotalDebts == 0 ? 1 : Model.TotalDebts);
            string emoji;
            string explanation;

            if (ratio > 1.2m)
            {
                emoji = "😊";
                explanation = "You are in a great financial position! Keep up the good work.";
            }
            else if (ratio >= 0.8m && ratio <= 1.2m)
            {
                emoji = "😐";
                explanation = "Your income and debts are balanced. Consider saving more.";
            }
            else
            {
                emoji = "😟";
                explanation = "Your debts exceed your income. It's time to review your finances.";
            }
        }

        <h2>Income vs Debt Difference</h2>
        <div class="difference-result">
            <p style="font-size: 1.2em;">
                Difference: <strong>@difference.ToString("C")</strong>
                <span class="emoji" style="font-size: 2.5em;">@emoji</span>
            </p>
            <p class="explanation" style="font-size: 0.9em;">
                @explanation
            </p>
        </div>
    </div>
</div>

<div class="row">
    <!-- Income Distribution Chart -->
    <div class="col-md-6 chart-container">
        <h2>Income Distribution</h2>
        <p>Total Income:<b> @Model.TotalIncomes</b></p>
        <canvas id="incomeChart"></canvas>
    </div>

<div class="row">
    <!-- Spacer between charts -->
    <div class="col-md-12" style="height: 100px;"></div>
</div>

    <!-- Debt Distribution Chart -->
    <div class="col-md-6 chart-container">
        <h2>Debt Distribution</h2>
        <p>Total Debt:<b> @Model.TotalDebts</b></p>
        <canvas id="debtChart"></canvas>
    </div>
</div>

<div class="row">
    <!-- Spacer between charts -->
    <div class="col-md-12" style="height: 100px;"></div>
</div>

<div class="row">
    <!-- Total Debts vs Total Incomes Monthly Comparison Chart -->
    <div class="col-md-12 chart-container">
        <h2>Total Debts vs Total Incomes Monthly</h2>
        <canvas id="debtVsIncomeChart"></canvas>
    </div>
</div>

<!-- Analysis Section -->
<div class="row">
    <div class="analysis-section">
        <h2>Analysis</h2>
        <p>Your largest income source is: @Model.IncomeLabels.FirstOrDefault()</p>
        <p>Your highest debt category is: @Model.DebtLabels.FirstOrDefault()</p>
        <p>Total Debts: @Model.TotalDebts</p>
        <p>Total Incomes: @Model.TotalIncomes</p>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // Doughnut Chart for Income Distribution
    var ctxIncome = document.getElementById('incomeChart').getContext('2d');
    var incomeChart = new Chart(ctxIncome, {
        type: 'doughnut',
        data: {
            labels: @Html.Raw(Json.Serialize(Model.IncomeLabels)),
            datasets: [{
                data: @Html.Raw(Json.Serialize(Model.IncomeValues)),
                backgroundColor: ['#36a2eb', '#ff6384', '#4bc0c0', '#ffcd56', '#ff9f40'],
                borderColor: ['#36a2eb', '#ff6384', '#4bc0c0', '#ffcd56', '#ff9f40'],
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                tooltip: {
                    callbacks: {
                        label: function (context) {
                            return context.label + ': ' + context.raw.toLocaleString('en-US', { style: 'currency', currency: 'USD' });
                        }
                    }
                }
            }
        }
    });

    // Bar Chart for Debt Distribution-- doughnut
    var ctxDebt = document.getElementById('debtChart').getContext('2d');
    var debtChart = new Chart(ctxDebt, {
        type: 'doughnut',
        data: {
            labels: @Html.Raw(Json.Serialize(Model.DebtLabels)),
            datasets: [{
                data: @Html.Raw(Json.Serialize(Model.DebtValues)),
                backgroundColor: [
                    '#ffcd56', '#ff9f40', '#ff6384', '#36a2eb', '#cc65fe', '#ffce56'
                ],
                borderColor: '#ffffff',
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                tooltip: {
                    callbacks: {
                        label: function (context) {
                            var label = context.label || '';
                            var value = context.raw !== null ? context.raw.toLocaleString('en-US', { style: 'currency', currency: 'USD' }) : '';
                            return label + ': ' + value;
                        }
                    }
                }
            }
        }
    });

    // Line Chart for Monthly Debts vs Income Comparison
    var ctxDebtVsIncome = document.getElementById('debtVsIncomeChart').getContext('2d');
    var debtVsIncomeChart = new Chart(ctxDebtVsIncome, {
        type: 'line',
        data: {
            labels: @Html.Raw(Json.Serialize(Model.MonthLabels)),
            datasets: [{
                label: 'Total Debts',
                data: @Html.Raw(Json.Serialize(Model.MonthlyDebtValues)),
                borderColor: '#ff6384',
                backgroundColor: 'rgba(255, 99, 132, 0.2)',
                fill: true,
                tension: 0.1
            }, {
                label: 'Total Incomes',
                data: @Html.Raw(Json.Serialize(Model.MonthlyIncomeValues)),
                borderColor: '#36a2eb',
                backgroundColor: 'rgba(54, 162, 235, 0.2)',
                fill: true,
                tension: 0.1
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        callback: function (value) {
                            return value.toLocaleString('en-US', { style: 'currency', currency: 'USD' });
                        }
                    }
                }
            },
            plugins: {
                tooltip: {
                    callbacks: {
                        label: function (context) {
                            return context.dataset.label + ': ' + context.raw.toLocaleString('en-US', { style: 'currency', currency: 'USD' });
                        }
                    }
                }
            }
        }
    });
</script>

<style>
    .chart-container {
        width: 100%;
        max-width: 600px;
        height: 400px;
        margin: 30px auto;
    }

    .analysis-section {
        padding: 20px;
        margin-top: 40px;
        background-color: #f9f9f9;
        border-radius: 8px;
        text-align: center;
    }

    .difference-section {
        padding: 20px;
        margin-top: 40px;
        background-color: #e9f7ef;
        border-radius: 8px;
        text-align: center;
        border: 1px solid #28a745;
    }

    .difference-result {
        font-size: 1.5em;
        margin-top: 10px;
    }

        .difference-result .emoji {
            font-size: 2em;
            margin-left: 10px;
        }

    .explanation {
        font-size: 1.2em;
        margin-top: 10px;
        color: #555;
    }

    canvas {
        display: block;
        width: 100% !important;
        height: 100% !important;
    }

    h1, h2 {
        text-align: center;
        margin-bottom: 20px;
        color: #333;
    }

    p {
        font-size: 1.1em;
        color: #555;
        text-align: center;
    }
</style>
