@model DebtManagement.Web.DTOs.CalculatorViewModel

<h1>Financial Overview</h1>

<p>Total Debt: @Model.TotalDebt</p>
<p>Total Income: @Model.TotalIncome</p>
<p>Total Payments: @Model.TotalPayments</p>
<p>Net Balance: @Model.NetBalance</p>

<h2>Debts</h2>
<table class="table">
    <thead>
        <tr>
            <th>Debt Type</th>
            <th>Amount</th>
            <th>Remaining Amount</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var debt in Model.Debts)
        {
            <tr>
                <td>@debt.DebtType</td>
                <td>@debt.DebtAmount</td>
                <td>@debt.RemainingAmount</td>
            </tr>
        }
    </tbody>
</table>

<h2>Incomes</h2>
<table class="table">
    <thead>
        <tr>
            <th>Source</th>
            <th>Amount</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var income in Model.Incomes)
        {
            <tr>
                <td>@income.Source</td>
                <td>@income.MonthlyIncome</td>
            </tr>
        }
    </tbody>
</table>

<h2>Payments</h2>
<table class="table">
    <thead>
        <tr>
            <th>Date</th>
            <th>Amount</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var payment in Model.Payments)
        {
            <tr>
                <td>@payment.PaymentDate.ToString("d")</td>
                <td>@payment.AmountPaid</td>
            </tr>
        }
    </tbody>
</table>

<h2>Income Distribution</h2>
<div>
    <canvas id="incomeChart" width="400" height="200"></canvas>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    var ctx = document.getElementById('incomeChart').getContext('2d');

    var incomeData = {
        labels: @Html.Raw(Json.Serialize(Model.IncomeLabels)),  // Labels for x-axis
        datasets: [{
            label: 'Monthly Income',
            data: @Html.Raw(Json.Serialize(Model.IncomeValues)), // Data for y-axis
            backgroundColor: 'rgba(54, 162, 235, 0.2)',
            borderColor: 'rgba(54, 162, 235, 1)',
            borderWidth: 1
        }]
    };

    var myChart = new Chart(ctx, {
        type: 'bar',  // Chart type change this to something else to see different chart types or add a new one
        data: incomeData,
        options: {
            scales: {
                y: {
                    beginAtZero: true
                }
            }
        }
    });
</script>
