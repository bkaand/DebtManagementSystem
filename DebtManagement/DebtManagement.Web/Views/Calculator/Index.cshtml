@model DebtManagement.Web.DTOs.CalculatorViewModel

<h1>Financial Overview</h1>

<!-- Income Distribution Chart -->
<div class="chart-container">
    <h2>Income Distribution</h2>
    <canvas id="incomeChart"></canvas>
</div>

<!-- Debt Distribution Chart -->
<div class="chart-container">
    <h2>Debt Distribution</h2>
    <canvas id="debtChart"></canvas>
</div>

<!-- Payment Trends Chart -->
<div class="chart-container">
    <h2>Payment Trends</h2>
    <canvas id="paymentChart"></canvas>
</div>

<!-- Analysis Section -->
<div>
    <h2>Analysis</h2>
    <p>Your largest income source is: @Model.IncomeLabels.FirstOrDefault()</p>
    <p>Your highest debt category is: @Model.DebtLabels.FirstOrDefault()</p>
    <p>The month with the highest payment is: @Model.PaymentLabels.FirstOrDefault()</p>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // Doughnut Chart for Income Distribution
    var ctxIncome = document.getElementById('incomeChart').getContext('2d');
    var incomeChart = new Chart(ctxIncome, {
        type: 'doughnut',
        data: {
            labels: @Html.Raw(Json.Serialize(Model.IncomeLabels)),
            datasets: [{
                data: @Html.Raw(Json.Serialize(Model.IncomeValues)),
                backgroundColor: ['rgba(54, 162, 235, 0.2)', 'rgba(255, 99, 132, 0.2)', 'rgba(75, 192, 192, 0.2)'],
                borderColor: ['rgba(54, 162, 235, 1)', 'rgba(255, 99, 132, 1)', 'rgba(75, 192, 192, 1)'],
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false
        }
    });

    // Bar Chart for Debt Distribution
    var ctxDebt = document.getElementById('debtChart').getContext('2d');
    var debtChart = new Chart(ctxDebt, {
        type: 'bar',
        data: {
            labels: @Html.Raw(Json.Serialize(Model.DebtLabels)),
            datasets: [{
                data: @Html.Raw(Json.Serialize(Model.DebtValues)),
                backgroundColor: 'rgba(255, 206, 86, 0.2)',
                borderColor: 'rgba(255, 206, 86, 1)',
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: {
                    beginAtZero: true
                }
            }
        }
    });

    // Polar Area Chart for Payment Trends
    var ctxPayment = document.getElementById('paymentChart').getContext('2d');
    var paymentChart = new Chart(ctxPayment, {
        type: 'polarArea',
        data: {
            labels: @Html.Raw(Json.Serialize(Model.PaymentLabels)),
            datasets: [{
                data: @Html.Raw(Json.Serialize(Model.PaymentValues)),
                backgroundColor: ['rgba(255, 99, 132, 0.2)', 'rgba(75, 192, 192, 0.2)', 'rgba(153, 102, 255, 0.2)'],
                borderColor: ['rgba(255, 99, 132, 1)', 'rgba(75, 192, 192, 1)', 'rgba(153, 102, 255, 1)'],
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false
        }
    });
</script>

<style>
    .chart-container {
        width: 300px;
        height: 150px;
        margin: 0 auto;
    }

    canvas {
        display: block;
        width: 100% !important;
        height: 100% !important;
    }
</style>
