@model DebtManagement.Web.DTOs.DebtDTO

@{
	ViewData["Title"] = "Debt Details";
}

<div class="container mt-5">
	<h1 class="text-center">Debt Details</h1>

	<div class="card mt-4">
		<div class="card-header">
			<h4 class="mb-0">Debt Information</h4>
		</div>
		<div class="card-body">
			<dl class="row">
				<dt class="col-sm-3">
					@Html.DisplayNameFor(model => model.DebtType)
				</dt>
				<dd class="col-sm-9">
					@Html.DisplayFor(model => model.DebtType)
				</dd>
				<dt class="col-sm-3">
					@Html.DisplayNameFor(model => model.DebtAmount)
				</dt>
				<dd class="col-sm-9">
					@Html.DisplayFor(model => model.DebtAmount)
				</dd>
				<dt class="col-sm-3">
					@Html.DisplayNameFor(model => model.Installments)
				</dt>
				<dd class="col-sm-9">
					@Html.DisplayFor(model => model.Installments)
				</dd>
				<dt class="col-sm-3">
					@Html.DisplayNameFor(model => model.RemainingAmount)
				</dt>
				<dd class="col-sm-9">
					@Html.DisplayFor(model => model.RemainingAmount)
				</dd>
				<dt class="col-sm-3">
					@Html.DisplayNameFor(model => model.EarlyClosingAmount)
				</dt>
				<dd class="col-sm-9">
					@Html.DisplayFor(model => model.EarlyClosingAmount)
				</dd>
				<dt class="col-sm-3">
					@Html.DisplayNameFor(model => model.InterestRateYearly)
				</dt>
				<dd class="col-sm-9">
					@Html.DisplayFor(model => model.InterestRateYearly)
				</dd>
				<dt class="col-sm-3">
					@Html.DisplayNameFor(model => model.InsuranceAmount)
				</dt>
				<dd class="col-sm-9">
					@Html.DisplayFor(model => model.InsuranceAmount)
				</dd>
				<dt class="col-sm-3">
					@Html.DisplayNameFor(model => model.CreatedDate)
				</dt>
				<dd class="col-sm-9">
					@Html.DisplayFor(model => model.CreatedDate)
				</dd>
			</dl>
		</div>
	</div>

	<div class="mt-4">
		<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
		<a asp-action="Index" class="btn btn-secondary">Back to List</a>
	</div>
</div>